[0.952, "o", "usage: switrs [-h] {ask,chat,sql,context,describe,values,trace} ...\r\n\r\nAsk the SWITRS collision agent, or query its tools directly.\r\n\r\npositional arguments:\r\n  {ask,chat,sql,context,describe,values,trace}\r\n    ask                 ask one question\r\n    chat                interactive conversation with follow-ups\r\n    sql                 run one guarded SELECT (no model)\r\n    context             print the grounding context the agent reads\r\n    describe            columns of one table\r\n    values              most common values of a column\r\n    trace               render a session trace to HTML\r\n\r\noptions:\r\n  -h, --help            show this help message and exit\r\n"]
[0.169, "o", "\r\n"]
